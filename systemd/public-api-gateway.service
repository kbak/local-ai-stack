[Unit]
Description=Authenticated OpenAI-compatible public API gateway
After=network.target

[Service]
Type=simple
WorkingDirectory="@STACK_ROOT@/public-api-gateway"
EnvironmentFile="@STACK_ROOT@/public-api.env"
ExecStart="@STACK_ROOT@/public-api-gateway/.venv/bin/uvicorn" app:app --host 127.0.0.1 --port 8093 --workers 1 --no-access-log --no-proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=default.target
