# The mailbox is dedicated to forwarded travel confirmations.
TRAVEL_IMAP_HOST=imap.gmail.com
TRAVEL_IMAP_PORT=993
TRAVEL_IMAP_USERNAME=travel@example.com
TRAVEL_IMAP_PASSWORD=replace-with-app-password

# Optional; defaults shown. CalDAV, LLM, and polling settings come from .env.
TRAVEL_CALENDAR_NAME=Travel
PDF_MCP_URL=http://pdf-inspector:8085/mcp/
