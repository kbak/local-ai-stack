# RSS feeds grouped by category (JSON object: category → list of feed URLs)
# signal-bot.env already provides: LLM_BASE_URL, LLM_API_KEY, LLM_MODEL,
#   SIGNAL_API_URL, SIGNAL_NUMBER, BRIEFING_RECIPIENT — no need to repeat them here
RSS_FEEDS={"technology": ["https://feeds.arstechnica.com/arstechnica/index", "https://www.theverge.com/rss/index.xml"], "general": ["https://feeds.bbci.co.uk/news/rss.xml"], "cars": ["https://www.motortrend.com/feeds/all/"]}

# How many hours back to scan per run — default matches the twice-daily cadence
# RSS_LOOKBACK_HOURS=12

# Recipient: phone number or group.<id>. Unset → falls back to BRIEFING_RECIPIENT (DM).
# RSS_RECIPIENT=group.XXXX

# Follow the RSS brief with TTS voice notes (blog briefs are always text-only).
# Uses audio-api + TTS_VOICE from signal-bot.env.
# SIGNAL_VOICE_BRIEF=1

# Optional weekly blog brief, within this same service: Tuesday 10:00 local time.
# Copy services/rss-watcher/blog-sources.example.json to services/rss-watcher/blog-sources.json,
# then replace the placeholders. The local subscription list is gitignored.
BLOG_SOURCES_FILE=/app/blog-sources.json
BLOG_TIMEZONE=UTC
# Personal messages only; defaults to BRIEFING_RECIPIENT, never RSS_RECIPIENT.
# BLOG_RECIPIENT=+1234567890
