# Cloudflare — used by Caddy (DNS-01 challenge) and scripts/dns-sync.sh
STACK_DOMAIN=example.com
ACME_EMAIL=admin@example.com
CLOUDFLARE_API_TOKEN=your-token-here
CLOUDFLARE_ZONE_ID=your-zone-id-here

# Routes from application containers to host services. For separate hosts,
# replace these with reachable private URLs; host.docker.internal is local.
LLM_BASE_URL=http://host.docker.internal:8080/v1
AUDIO_API_URL=http://host.docker.internal:8088
MEMORY_MCP_URL=http://host.docker.internal:8089
YTDLP_SERVICE_URL=http://host.docker.internal:8200
# Exact hosts/origins accepted by memory MCP. Include your HTTPS proxy when used.
MEMORY_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,memory-mcp:8089,host.docker.internal:8089
MEMORY_ALLOWED_ORIGINS=http://localhost:8089,http://127.0.0.1:8089
TIER1_AGENT_NAME=Assistant
# SIGNAL_CALL_GREETING="Signal calling works. Talk to you soon."
# SIGNAL_OFFLINE_REPLIES_FILE=/absolute/path/to/private/offline-replies.txt

MONGO_URI=mongodb://mongodb:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3000
DOMAIN_SERVER=http://localhost:3000
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_REFRESH_SECRET=change_me_to_a_different_random_64_char_hex_string
ALLOW_REGISTRATION=true
MCP_ALLOWED_DOMAINS=http://mcp-proxy:8083
MCP_PROXY_AUTH_TOKEN=change_me_to_a_random_secret

# Local Qwen-Image 2.1 via LibreChat's image toolkit. By default Compose uses
# LLM_BASE_URL (or http://host.docker.internal:8080/v1) and the local placeholder key.
# Override only when image requests need a different route or authentication.
# IMAGE_GEN_OAI_BASEURL=http://host.docker.internal:8080/v1
# IMAGE_GEN_OAI_API_KEY=vllm

# GitHub MCP (read-only token, scopes: public_repo or repo for private)
GITHUB_TOKEN=your-token-here

# CalDAV (shared by mcp-proxy caldav tool, location-tracker, and meal-watcher)
CALDAV_BASE_URL=https://your-nextcloud.example.com/remote.php/dav
CALDAV_USERNAME=your-username
CALDAV_PASSWORD=your-app-password

# Location Tracker + Meal Watcher (shared)
HOME_CITY="Your City"
LOCAL_TIMEZONE=UTC
CALDAV_CALENDAR_NAMES=Travel        # comma-separated calendar names; empty = all calendars
POLL_INTERVAL_MINUTES=5
LOOKBACK_DAYS=30
LOOKAHEAD_DAYS=90

# Google places api key
GOOGLE_MAPS_API_KEY=api_key

# Brave Search API (used by SearXNG's official braveapi engine)
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
SEARXNG_SECRET=change_me_to_a_random_secret

# Generic headless browser-agent API (port 8092). Set a token before exposing
# the port outside a trusted LAN. The service uses the stack's OpenAI-compatible
# LLM_BASE_URL and defaults to qwen3.8-27B-FP8.
BROWSER_AGENT_API_TOKEN=change_me_to_a_random_secret
BROWSER_AGENT_LLM_MODEL=qwen3.8-27B-FP8
# Browser tasks require the isolated Steel service and public-egress proxy.
# External CDP endpoints and local Chromium fallback are disabled.
BROWSER_AGENT_CDP_URL=
# Addresses inside the isolated Compose browser network.
BROWSER_AGENT_STEEL_BASE_URL=http://steel-browser:3000
BROWSER_AGENT_STEEL_PUBLIC_URL=http://steel-browser:3000
BROWSER_AGENT_STEEL_API_KEY=
BROWSER_AGENT_STEEL_PROXY_URL=
BROWSER_AGENT_STEEL_SOLVE_CAPTCHA=false
BROWSER_AGENT_STEEL_RESOLVE_WS_HOST=true
# Maximum bytes downloaded for any single image-analysis asset (default 12 MiB).
BROWSER_AGENT_IMAGE_DOWNLOAD_LIMIT_BYTES=12582912

# Long-term memory (mem0 + Qdrant).
# MEMORY_DIR is an absolute path on the host where SOUL.md, USER.md,
# MEMORY.md, and Qdrant's vector storage live. Keep this outside the repo
# so it isn't accidentally committed.
MEMORY_DIR=/absolute/path/to/your/memory
# Identifier for the default memory scope. Single-user setups can leave this
# as-is; multi-user deployments should pass user_id explicitly from the client.
MEMORY_DEFAULT_USER_ID=default

# Primary GPU: chat, autocomplete, and FLUX workers. Qwen-Image also accepts
# its own QWEN_IMAGE_GPU override.
PRIMARY_GPU=0
# Optional exact PyTorch device-name check. Empty accepts the selected device;
# audio still requires exactly one visible GPU.
EXPECTED_AUDIO_GPU=
# Docker bridge address used by memory-mcp and the private llama-swap relay.
AI_BRIDGE_ADDRESS=172.18.0.1

# Secondary GPU: hosts audio-api (Whisper + Kokoro + voice cloning) and the
# bge-reranker-v2-m3 model in llama-swap. Accepts an index ("0", "1", ...)
# or a stable UUID ("GPU-xxxx...") from `nvidia-smi -L`. Defaults to "0"
# (first GPU). A single-GPU host must size the model set to fit. On multi-GPU hosts, point
# this at the smaller card to leave the primary GPU free for LLMs.
# Must also be exported in the shell where llama-swap runs (used by the
# reranker launcher).
SECONDARY_GPU=0

# Host directory containing reference .wav files for Chatterbox voice cloning.
# Mounted read-only into audio-api at /app/voice-samples and read-write into
# signal-bot at /app/voice-samples (so /sample can write new samples).
# Filename stem (e.g. "joe" for joe.wav) is what gets passed as the `voice`
# arg to clone_voice.
VOICE_SAMPLES_DIR=/absolute/path/to/your/voice-samples

# Host directory containing music files served by signal-bot's music skill.
# Mounted read-write into signal-bot at /music.
MUSIC_HOST_DIR=/absolute/path/to/your/music

# Optional bearer token for the host-side yt-dlp service (port 8200).
# If set, signal-bot's music_download and sample_download skills will send this
# token and the service will reject requests without it. Leave empty to allow
# unauthenticated access (fine for a trusted home LAN).
# Also set YTDLP_SERVICE_TOKEN in signal-bot.env to the same value.
YTDLP_SERVICE_TOKEN=

# Reverse image search (reverse-image-search service)
# SauceNAO: free API key at https://saucenao.com/user.php (100 req/day on free tier)
# Private images (from Signal/Telegram) are uploaded to Litterbox with a 1h TTL — no account needed.
SAUCENAO_API_KEY=your-saucenao-api-key

# Nextcloud (self-hosted, exposed via tailscale)
NEXTCLOUD_TAILSCALE_HOST=machine-name.tail1234.ts.net:8443
NEXTCLOUD_DB_ROOT_PASSWORD=change_me_to_a_random_secret
NEXTCLOUD_DB_PASSWORD=change_me_to_a_random_secret
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_to_a_strong_password
