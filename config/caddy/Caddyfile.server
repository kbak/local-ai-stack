# Env vars required: STACK_DOMAIN, ACME_EMAIL, CLOUDFLARE_API_TOKEN
# Put them in /etc/caddy/caddy.env — loaded automatically by the official Caddy service.
# The cloudflare DNS module must be compiled in (xcaddy or official CF binary).
{
	email {env.ACME_EMAIL}
	auto_https disable_redirects
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

voice.{$STACK_DOMAIN} {
	reverse_proxy 127.0.0.1:8087
}

chat.{$STACK_DOMAIN} {
	reverse_proxy 127.0.0.1:3000
}

search.{$STACK_DOMAIN} {
	reverse_proxy 127.0.0.1:8081
}

pdf.{$STACK_DOMAIN} {
	reverse_proxy 127.0.0.1:8086
}

mcp.{$STACK_DOMAIN} {
	reverse_proxy 127.0.0.1:8083
}

nextcloud.{$STACK_DOMAIN} {
	header Strict-Transport-Security "max-age=15552000"
	reverse_proxy 127.0.0.1:8090
}

yt.{$STACK_DOMAIN} {
	reverse_proxy 127.0.0.1:8200
}
