{
  "mcpServers": {
    "searxng": {
      "command": "python",
      "args": [
        "/opt/searxng-server.py"
      ],
      "env": {
        "SEARXNG_URL": "http://searxng:8080"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.28.0",
        "mcp-server-fetch==2025.4.7"
      ]
    },
    "arxiv": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.28.0",
        "arxiv-mcp-server==0.4.11"
      ]
    },
    "youtube": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.28.0",
        "mcp-youtube-transcript==0.3.5"
      ]
    },
    "time": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.28.0",
        "mcp-server-time==2026.1.26"
      ]
    },
    "weather": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.28.0",
        "--from",
        "mcp-weather-server==0.6.1",
        "mcp_weather_server"
      ]
    },
    "currency": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.28.0",
        "frankfurtermcp==0.4.4"
      ]
    },
    "finance": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.28.0",
        "yfinance-mcp-server==1.0.4"
      ]
    },
    "github": {
      "command": "python",
      "args": [
        "/opt/gh-read-server.py"
      ]
    },
    "google-maps": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "google-maps-mcp-server==0.2.1",
        "--with",
        "mcp==1.28.0",
        "python",
        "/opt/gmaps-searchtext-shim.py"
      ]
    },
    "browser": {
      "command": "python",
      "args": [
        "/opt/browser-agent-server.py"
      ],
      "env": {
        "BROWSER_AGENT_API_URL": "http://browser-agent-api:8092"
      }
    }
  }
}
